[
  {
    "id": "V001",
    "scene": 0,
    "text": "四级楼梯，",
    "spoken": "四级楼梯，"
  },
  {
    "id": "V002",
    "scene": 0,
    "text": "每次只能走一级或两级，",
    "spoken": "每次只能走一级或两级，"
  },
  {
    "id": "V003",
    "scene": 0,
    "text": "一共有多少种走法？",
    "spoken": "一共有多少种走法？"
  },
  {
    "id": "V004",
    "scene": 1,
    "text": "先试着列出来：",
    "spoken": "先试着列出来："
  },
  {
    "id": "V005",
    "scene": 1,
    "text": "四次一步，",
    "spoken": "四次一步，"
  },
  {
    "id": "V006",
    "scene": 1,
    "text": "两次两步，",
    "spoken": "两次两步，"
  },
  {
    "id": "V007",
    "scene": 1,
    "text": "以及把一次两步放在不同的位置。",
    "spoken": "以及把一次两步放在不同的位置。"
  },
  {
    "id": "V008",
    "scene": 1,
    "text": "一共五种。",
    "spoken": "一共五种。"
  },
  {
    "id": "V009",
    "scene": 1,
    "text": "可如果楼梯变成几十级，",
    "spoken": "可如果楼梯变成几十级，"
  },
  {
    "id": "V010",
    "scene": 1,
    "text": "一条条列，",
    "spoken": "一条条列，"
  },
  {
    "id": "V011",
    "scene": 1,
    "text": "就很麻烦了。",
    "spoken": "就很麻烦了。"
  },
  {
    "id": "V012",
    "scene": 2,
    "text": "换个角度，",
    "spoken": "换个角度，"
  },
  {
    "id": "V013",
    "scene": 2,
    "text": "只看最后一步。",
    "spoken": "只看最后一步。"
  },
  {
    "id": "V014",
    "scene": 2,
    "text": "到达第四级，",
    "spoken": "到达第四级，"
  },
  {
    "id": "V015",
    "scene": 2,
    "text": "最后要么从第三级走一步，",
    "spoken": "最后要么从第三级走一步，"
  },
  {
    "id": "V016",
    "scene": 2,
    "text": "要么从第二级走两步。",
    "spoken": "要么从第二级走两步。"
  },
  {
    "id": "V017",
    "scene": 2,
    "text": "没有第三种情况，",
    "spoken": "没有第三种情况，"
  },
  {
    "id": "V018",
    "scene": 2,
    "text": "这两类走法也不会重复。",
    "spoken": "这两类走法也不会重复。"
  },
  {
    "id": "V019",
    "scene": 2,
    "text": "所以，",
    "spoken": "所以，"
  },
  {
    "id": "V020",
    "scene": 2,
    "text": "到第四级的走法，",
    "spoken": "到第四级的走法，"
  },
  {
    "id": "V021",
    "scene": 2,
    "text": "等于到第三级的走法，",
    "spoken": "等于到第三级的走法，"
  },
  {
    "id": "V022",
    "scene": 2,
    "text": "加上到第二级的走法。",
    "spoken": "加上到第二级的走法。"
  },
  {
    "id": "V023",
    "scene": 3,
    "text": "我们把到达第 i 级的走法数量，",
    "spoken": "我们把到达第艾级的走法数量，"
  },
  {
    "id": "V024",
    "scene": 3,
    "text": "记作 dp[i]。",
    "spoken": "记作 D P 下标艾。"
  },
  {
    "id": "V025",
    "scene": 3,
    "text": "这就是“状态”的含义。",
    "spoken": "这就是“状态”的含义。"
  },
  {
    "id": "V026",
    "scene": 3,
    "text": "刚才的关系写成公式，",
    "spoken": "刚才的关系写成公式，"
  },
  {
    "id": "V027",
    "scene": 3,
    "text": "就是 dp[i] 等于 dp[i-1] 加 dp[i-2]。",
    "spoken": "就是 D P 下标艾 等于 D P 下标艾减一 加 D P 下标艾减二。"
  },
  {
    "id": "V028",
    "scene": 3,
    "text": "公式来自最后一步的分类，",
    "spoken": "公式来自最后一步的分类，"
  },
  {
    "id": "V029",
    "scene": 3,
    "text": "不需要硬背。",
    "spoken": "不需要硬背。"
  },
  {
    "id": "V030",
    "scene": 4,
    "text": "但计算总得有个起点。",
    "spoken": "但计算总得有个起点。"
  },
  {
    "id": "V031",
    "scene": 4,
    "text": "第零级，",
    "spoken": "第零级，"
  },
  {
    "id": "V032",
    "scene": 4,
    "text": "就是还没开始爬，",
    "spoken": "就是还没开始爬，"
  },
  {
    "id": "V033",
    "scene": 4,
    "text": "原地不动算一种走法，",
    "spoken": "原地不动算一种走法，"
  },
  {
    "id": "V034",
    "scene": 4,
    "text": "所以 dp[0] 等于一。",
    "spoken": "所以 D P 下标零 等于一。"
  },
  {
    "id": "V035",
    "scene": 4,
    "text": "第一级只能走一步，",
    "spoken": "第一级只能走一步，"
  },
  {
    "id": "V036",
    "scene": 4,
    "text": "所以 dp[1] 也等于一。",
    "spoken": "所以 D P 下标一 也等于一。"
  },
  {
    "id": "V037",
    "scene": 5,
    "text": "接下来从小往大算。",
    "spoken": "接下来从小往大算。"
  },
  {
    "id": "V038",
    "scene": 5,
    "text": "第二级，",
    "spoken": "第二级，"
  },
  {
    "id": "V039",
    "scene": 5,
    "text": "一加一，",
    "spoken": "一加一，"
  },
  {
    "id": "V040",
    "scene": 5,
    "text": "等于二。",
    "spoken": "等于二。"
  },
  {
    "id": "V041",
    "scene": 5,
    "text": "第三级，",
    "spoken": "第三级，"
  },
  {
    "id": "V042",
    "scene": 5,
    "text": "二加一，",
    "spoken": "二加一，"
  },
  {
    "id": "V043",
    "scene": 5,
    "text": "等于三。",
    "spoken": "等于三。"
  },
  {
    "id": "V044",
    "scene": 5,
    "text": "第四级，",
    "spoken": "第四级，"
  },
  {
    "id": "V045",
    "scene": 5,
    "text": "三加二，",
    "spoken": "三加二，"
  },
  {
    "id": "V046",
    "scene": 5,
    "text": "等于五。",
    "spoken": "等于五。"
  },
  {
    "id": "V047",
    "scene": 5,
    "text": "每次只读取前两个已经算好的格子，",
    "spoken": "每次只读取前两个已经算好的格子，"
  },
  {
    "id": "V048",
    "scene": 5,
    "text": "再把答案存进新的格子。",
    "spoken": "再把答案存进新的格子。"
  },
  {
    "id": "V049",
    "scene": 6,
    "text": "这就是动态规划的一种基本做法：",
    "spoken": "这就是动态规划的一种基本做法："
  },
  {
    "id": "V050",
    "scene": 6,
    "text": "先解决小问题，",
    "spoken": "先解决小问题，"
  },
  {
    "id": "V051",
    "scene": 6,
    "text": "存下答案，",
    "spoken": "存下答案，"
  },
  {
    "id": "V052",
    "scene": 6,
    "text": "再用这些答案解决更大的问题，",
    "spoken": "再用这些答案解决更大的问题，"
  },
  {
    "id": "V053",
    "scene": 6,
    "text": "减少重复计算。",
    "spoken": "减少重复计算。"
  },
  {
    "id": "V054",
    "scene": 6,
    "text": "对应到代码，",
    "spoken": "对应到代码，"
  },
  {
    "id": "V055",
    "scene": 6,
    "text": "就是先填好初始值，",
    "spoken": "就是先填好初始值，"
  },
  {
    "id": "V056",
    "scene": 6,
    "text": "再用一个循环，",
    "spoken": "再用一个循环，"
  },
  {
    "id": "V057",
    "scene": 6,
    "text": "依次填写后面的格子。",
    "spoken": "依次填写后面的格子。"
  },
  {
    "id": "V058",
    "scene": 7,
    "text": "初学动态规划，",
    "spoken": "初学动态规划，"
  },
  {
    "id": "V059",
    "scene": 7,
    "text": "先问三个问题：",
    "spoken": "先问三个问题："
  },
  {
    "id": "V060",
    "scene": 7,
    "text": "这个格子表示什么？",
    "spoken": "这个格子表示什么？"
  },
  {
    "id": "V061",
    "scene": 7,
    "text": "它能从哪些更小的问题算出来？",
    "spoken": "它能从哪些更小的问题算出来？"
  },
  {
    "id": "V062",
    "scene": 7,
    "text": "最开始的答案是什么？",
    "spoken": "最开始的答案是什么？"
  },
  {
    "id": "V063",
    "scene": 7,
    "text": "并不是所有题都把前两项相加，",
    "spoken": "并不是所有题都把前两项相加，"
  },
  {
    "id": "V064",
    "scene": 7,
    "text": "重要的是根据题目找到关系。",
    "spoken": "重要的是根据题目找到关系。"
  },
  {
    "id": "V065",
    "scene": 7,
    "text": "现在轮到你：",
    "spoken": "现在轮到你："
  },
  {
    "id": "V066",
    "scene": 7,
    "text": "如果有五级楼梯，",
    "spoken": "如果有五级楼梯，"
  },
  {
    "id": "V067",
    "scene": 7,
    "text": "每次仍然走一级或两级，",
    "spoken": "每次仍然走一级或两级，"
  },
  {
    "id": "V068",
    "scene": 7,
    "text": "有多少种走法？",
    "spoken": "有多少种走法？"
  },
  {
    "id": "V069",
    "scene": 7,
    "text": "暂停一下，",
    "spoken": "暂停一下，"
  },
  {
    "id": "V070",
    "scene": 7,
    "text": "用刚才的表格继续算。",
    "spoken": "用刚才的表格继续算。"
  }
]
